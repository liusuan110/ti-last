GPIO3.associatedPins[2].assignedPort     = "PORTA";
GPIO3.associatedPins[2].assignedPin      = "12";
GPIO3.associatedPins[2].direction        = "INPUT";
GPIO3.associatedPins[2].internalResistor = "PULL_UP";
GPIO3.associatedPins[2].pin.$assign      = "PA12";

/*
 * F-problem output-path relay.
 * PA13 low: relay released, NC -> COM, source input passes through.
 * PA13 high: relay energized, NO -> COM, DDS amplifier drives the output.
 */
GPIO4.$name                          = "GPIO_RELAY";
GPIO4.associatedPins.create(1);
GPIO4.associatedPins[0].$name        = "CTRL";
GPIO4.associatedPins[0].assignedPort = "PORTA";
GPIO4.associatedPins[0].assignedPin  = "13";
GPIO4.associatedPins[0].pin.$assign  = "PA13";

/*
 * Dedicated external sound/light output.
 * PA1 high: S8050 on, external active buzzer and LED both on.
 * PA1 low:  S8050 off, both loads off. This pin is not shared with RGB/DDS.
 */
GPIO5.$name                          = "GPIO_SOUND_LIGHT";
GPIO5.associatedPins.create(1);
GPIO5.associatedPins[0].$name        = "ALERT";
GPIO5.associatedPins[0].assignedPort = "PORTA";
GPIO5.associatedPins[0].assignedPin  = "1";
GPIO5.associatedPins[0].pin.$assign  = "PA1";

